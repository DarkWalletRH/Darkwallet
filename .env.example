# Copy to .env.local to override. Every variable is optional; with none set, the app uses the
# public RPC endpoints recorded in the SDK's deployments.
#
# Verifying a disclosure reads the chain at the block the disclosure names. The public endpoints
# keep only recent state (about 6,000 blocks, roughly 10 to 20 minutes), so checking an older link
# needs an endpoint that serves historical state (an archive node).
#
# VITE_* variables are compiled into the JavaScript bundle and are visible to every visitor.
# Never put a private key, a seed phrase, an API key or a keyed RPC URL here.

# JSON-RPC endpoint for Robinhood Chain mainnet (chain id 4663).
VITE_MAINNET_RPC_URL=

# JSON-RPC endpoint for Robinhood Chain testnet (chain id 46630).
VITE_TESTNET_RPC_URL=
